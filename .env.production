# Production Environment Variables for Vercel
# ⚠️  IMPORTANT: Update these in Vercel Project Settings, not just in this file
# Vercel Dashboard → Project Settings → Environment Variables
# Add these variables for Preview, Production, and Development

# Backend API URL
# Replace "yourdomain.com" with your actual production API domain
# Example: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Frontend Application URL  
# Replace "yourdomain.com" with your actual production domain
# Example: https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Analytics (Optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Error Tracking (Optional)
# NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
# NEXT_PUBLIC_SENTRY_DSN=
